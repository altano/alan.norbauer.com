ASTRO_TELEMETRY_DISABLED=true
NODE_ENV=testing
WEBSERVER_PORT=3842
# Astro 7 moves `astro dev` into the background when it detects an AI agent
# (CLAUDECODE, AI_AGENT and similar), so the command exits and Playwright stops
# with "Process from config.webServer exited early". ASTRO_DEV_BACKGROUND is
# the marker Astro sets on its own background child, and it turns that
# detection off. --ignore-lock lets this run beside a `pnpm dev` you already
# have open, which Astro's lock file would otherwise refuse.
WEBSERVER_COMMAND="ASTRO_DEV_BACKGROUND=1 pnpm dev --port 3842 --ignore-lock"
WEBSERVER_URL="http://localhost:3842/"