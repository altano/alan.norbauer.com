---
export type Props = {
  kind?: undefined | "info" | "warning" | "alarm";
  children: unknown;
};

const { kind } = Astro.props;
const icon =
  kind === "info"
    ? "💡"
    : kind === "warning"
      ? "⚠️"
      : kind === "alarm"
        ? "🚨"
        : null;
---

<style>
  @layer components {
    div.callout {
      @mixin card;

      font-size: 1rem;

      p:last-child {
        margin: 0;
      }

      .icon {
        float: left;
        margin: 0 var(--spacing-3);
        font-size: 2rem;
      }
    }
  }
</style>

<div class="callout">
  {
    icon != null ? (
      <>
        <span class="icon">{icon}</span>
        <div class="text">
          <slot />
        </div>
      </>
    ) : (
      <slot />
    )
  }
</div>
